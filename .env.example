# Copy to .env and fill in. Never commit .env. Every name is explained in docs/04-ENVIRONMENT-VARIABLES.md

# Core
APP_NAME=booklantern
DATABASE_URL=sqlite:///./booklantern.sqlite3
# Make one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"  (32 or more random characters; the app refuses to start on this example value when DEMO_MODE is false)
SESSION_SECRET=change-me-to-a-long-random-string
# draft: nothing leaves the machine. live: real posting and sending, only after docs/09-GO-LIVE-CHECKLIST.md
MODE=draft
# false for any real install. true only for the offline demo with fictional data (it also switches on a public demo password until OWNER_PASSWORD_HASH is set)
DEMO_MODE=false
# Only for a throw away demo on a server database. Leave false.
ALLOW_DEMO_SERVER=false
KILL_SWITCH=false
# The largest request the API accepts, in bytes (25 MB)
MAX_BODY_BYTES=26214400
HANDOFF_DIR=./handoff
UPLOAD_DIR=./uploads
# The folder with the demo data. Set automatically when you run from the repository.
SEED_DIR=
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Sign in (make the hash with: python tools/hash_password.py). Keep the single quotes.
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD_HASH=
APPROVER_EMAIL=
APPROVER_PASSWORD_HASH=
VIEWER_EMAIL=
VIEWER_PASSWORD_HASH=
LOGIN_BURST=5

# Company. These are printed in the footer of every reminder, and bills addressed to any other name are flagged. Set them before MODE=live.
COMPANY_NAME=Birchfield Supply Co
# Your physical postal address, one line
COMPANY_ADDRESS=
# Where customers answer a reminder (also the address in the unsubscribe header). Empty means EMAIL_FROM, which is refused when the bills mailbox is the sender mailbox. Use a mailbox a person reads.
REPLY_TO=
BASE_CURRENCY=USD
# The time zone of a customer imported without one, for example Europe/London
DEFAULT_TIMEZONE=America/New_York
# Exchange rates for other currencies are typed in the app (Reports page) by date. None is guessed.

# Which adapter each job uses: seed is offline and safe
ACCOUNTING_ADAPTER=seed
PAYMENTS_ADAPTER=seed
INBOX_ADAPTER=seed
EMAIL_ADAPTER=seed
# EXTRACTOR=live makes a language model read each bill (code checks every value). UNVERIFIED live. It needs LLM_BACKEND=anthropic and a key to use a real model.
EXTRACTOR=offline
# REMINDER_WRITER=model lets the model word reminders (checked by code, a person still approves each one). template is the default wording.
REMINDER_WRITER=template
ACCOUNTING_WRITE=false

# QuickBooks (accounting adapter quickbooks): all or none
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
QBO_ENVIRONMENT=sandbox
QBO_MINOR_VERSION=75
# Advanced: other addresses for QuickBooks (empty means the usual ones)
QBO_API_BASE=
QBO_TOKEN_URL=https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer

# Xero (accounting adapter xero): all or none
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=
XERO_BASE_URL=https://api.xero.com

# Akaunting (accounting adapter akaunting): all or none
AKAUNTING_BASE_URL=
AKAUNTING_USER=
AKAUNTING_PASSWORD=

# CSV files (accounting adapter csv): the folder holds invoices.csv and receives draft-bills.csv
CSV_FOLDER=./csv-in

# Stripe payment links (payments adapter stripe): all or none
STRIPE_SECRET_KEY=
STRIPE_BASE_URL=https://api.stripe.com

# Mailbox (inbox imap, email smtp): all or none. One user and password serve both, and every connection checks the server certificate. Plain text (false below) is refused for any host but 127.0.0.1.
# When the bills mailbox is also the sender mailbox, set REPLY_TO (above) to a mailbox a person reads, or customers' answers to a reminder land among the bills.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
IMAP_HOST=
IMAP_PORT=993
IMAP_USE_SSL=true
EMAIL_FROM=accounts@example.test
# Who may email bills in: comma separated addresses or @domains, for example billing@vendor.example,@supplier.example. Empty means anyone who knows the address. A bill from another sender is
# kept but blocked until a person approves it with a reason. A From line can be forged, so this narrows the door, it does not lock it.
INTAKE_ALLOWED_SENDERS=

# Reminder and forecast rules. Decided defaults (ladder at 1, 7, 14 and 30 days, net 30, 95, 90, 75, 50 and 20 percent collection chances); change them to fit the client
REMINDER_WINDOW_START=9
REMINDER_WINDOW_END=17
REMINDER_MIN_GAP_DAYS=5
REMINDER_MAX_COUNT=4
COLLECTION_PROB_BP=current=9500,1-30=9000,31-60=7500,61-90=5000,90+=2000

# Language model: LLM_BACKEND is offline (default), fixture or anthropic; anthropic needs a key and is UNVERIFIED. LLM_MODE is the older switch: LLM_BACKEND wins when both are set.
LLM_BACKEND=offline
LLM_MODE=fixture
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2026-10-21
# One model id for both kinds, or leave empty and set the two below
LLM_MODEL=
LLM_HARD_MODEL=claude-sonnet-5-5
LLM_BULK_MODEL=claude-haiku-5-5
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=2
# Spend limits for the live model: most calls per process, and most tracked dollars. Empty means no limit, so set one before you switch the live reader on.
LLM_CALL_BUDGET=
LLM_BUDGET_USD=
# default or off
LLM_THINKING=default
LLM_FIXTURES_DIR=
LLM_RECORD=false
LLM_REDACT=true
LLM_LOG_PROMPTS=false

# Web app
API_BASE_URL=http://127.0.0.1:8000

# Docker compose only. Letters and digits only (or percent-encode it): make one with  openssl rand -hex 24
POSTGRES_PASSWORD=
