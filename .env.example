# Copy to .env and fill in. Never commit .env. Explained in docs/04-ENVIRONMENT-VARIABLES.md
# Names only here. No real values belong in this file.

# Core
DATABASE_URL=sqlite:///./booklantern.sqlite3
SESSION_SECRET=change-me-to-a-long-random-string
MODE=draft
DEMO_MODE=true
KILL_SWITCH=false
HANDOFF_DIR=./handoff
UPLOAD_DIR=./uploads
SEED_DIR=

# Sign in (make the hash with: python tools/hash_password.py). Keep the single quotes.
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD_HASH=
APPROVER_EMAIL=
APPROVER_PASSWORD_HASH=
VIEWER_EMAIL=
VIEWER_PASSWORD_HASH=
LOGIN_BURST=5

# Company. Default is a made up demo name: set your client's legal name. Bills addressed to any other name are flagged
COMPANY_NAME=Birchfield Supply Co
BASE_CURRENCY=USD
# Exchange rates for other currencies are typed in the app (Reports page) by date. None is guessed.

# Which adapter each job uses: seed is offline and safe
ACCOUNTING_ADAPTER=seed
PAYMENTS_ADAPTER=seed
INBOX_ADAPTER=seed
EMAIL_ADAPTER=seed
# EXTRACTOR=live makes a language model read each bill (code checks every value). UNVERIFIED live. It needs LLM_BACKEND=anthropic and a key to use a real model.
EXTRACTOR=offline
# REMINDER_WRITER=model lets the model word reminders (checked by code, a person still approves each one). template is the default wording.
REMINDER_WRITER=template
ACCOUNTING_WRITE=false

# QuickBooks Online (accounting adapter quickbooks)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
QBO_ENVIRONMENT=sandbox
QBO_MINOR_VERSION=75

# Xero (accounting adapter xero)
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=

# Akaunting (accounting adapter akaunting)
AKAUNTING_BASE_URL=
AKAUNTING_USER=
AKAUNTING_PASSWORD=

# CSV files (accounting adapter csv)
CSV_FOLDER=./csv-in

# Stripe payment links (payments adapter stripe)
STRIPE_SECRET_KEY=

# Mailbox for bills and the sender of reminders (inbox adapter imap, email adapter smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
EMAIL_FROM=accounts@example.test

# Reminder and forecast rules. Decided defaults (ladder at 1, 7, 14 and 30 days, net 30, 95, 90, 75, 50 and 20 percent collection chances); change them to fit the client
REMINDER_WINDOW_START=9
REMINDER_WINDOW_END=17
REMINDER_MIN_GAP_DAYS=5
REMINDER_MAX_COUNT=4
COLLECTION_PROB_BP=current=9500,1-30=9000,31-60=7500,61-90=5000,90+=2000

# Language model: LLM_BACKEND is offline (default), fixture or anthropic; anthropic needs a key and is UNVERIFIED
LLM_BACKEND=offline
LLM_MODE=fixture
ANTHROPIC_API_KEY=

# Web app
API_BASE_URL=http://127.0.0.1:8000

# Docker compose only
POSTGRES_PASSWORD=
